{
  "name": "react-native-event",
  "version": "1.0.15",
  "description": "React context for subscribing to all react native interaction events",
  "keywords": [
    "react-native",
    "react",
    "native",
    "outside",
    "press",
    "touch",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmalakoff/react-native-event.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "npm run test:types && tsds test:browser --config wtr.config.mjs && tsds test:node --no-timeouts test/unit/lib/subscription-registry.test.ts test/exports/require.test.cjs",
    "test:engines": "tsds test:browser --config wtr.config.mjs && nvu engines tsds test:node --no-timeouts test/unit/lib/subscription-registry.test.ts test/exports/require.test.cjs",
    "test:types": "npm run build && node test/types/run.mjs",
    "version": "tsds version"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "^19.3.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "fs-remove-compat": "*",
    "node-version-use": "*",
    "react": "*",
    "react-dom": "^19.3.0",
    "react-native": "*",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-web-test-runner": "*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "esbuild": true
  }
}
